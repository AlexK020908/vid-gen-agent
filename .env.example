# Copy to .env (gitignored) and fill in. run.py loads it on start.

# Turns on the chat agent, and lets Claude write outlines and scripts (stickfleet.yaml: mode: live, providers.llm: claude).
# Without it the app still works on placeholders: card buttons, and the home composer starts videos directly.
ANTHROPIC_API_KEY=

# Voice (providers.tts: elevenlabs), pictures and clips (providers.images and providers.video: fal), when stickfleet.yaml has mode: live.
ELEVENLABS_API_KEY=
FAL_KEY=

# Competitors' recent uploads and view counts for topic ideas (stickfleet.yaml: topics.competitors: youtube).
# Google Cloud, same project as the OAuth client: Credentials, Create credentials, API key; restrict it to
# YouTube Data API v3. Public data only; it can't touch your channel.
YOUTUBE_API_KEY=
